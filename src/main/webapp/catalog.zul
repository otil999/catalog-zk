<?page title="OtilSoft Media Catalog" contentType="text/html;charset=UTF-8"?>
<!--<window border="normal" width="100%" height="100%" id="window" title="Catalog">-->
	<borderlayout width="100%" apply="hu.otilsoft.catalog.Controller">
		<north>
		    <div>
                <menubar>
                    <menu label="Database">
                        <menupopup>
                            <menuitem id="export" label="Export..."/>
                        </menupopup>
                    </menu>
                    <menu label="Data">
                        <menupopup>
                            <menuitem id="media" label="Media"/>
                            <menuitem id="genre" label="Genre"/>
                            <menuseparator/>
                            <menuitem id="movie" label="Movie"/>
                            <menuitem id="game" label="Game"/>
                        </menupopup>
                    </menu>
                    <menu label="Search"/>
                    <menu label="Statistics"/>
                </menubar>
                <toolbar>
                    fgdgfgfgfdgfdgfgfggfd
                </toolbar>
            </div>
		</north>
		<center id="center">
			<tabbox id="tabbox" visible="false" height="100%">
			    <tabs id="tabs"/>
			    <tabpanels id="tabpanels">
                </tabpanels>
			</tabbox>
		</center>
		<south>
			<toolbar>
				sdfsdfdsfdsfdsfdsfdsfdsf
			</toolbar>
		</south>
	</borderlayout>
<!--</window>-->

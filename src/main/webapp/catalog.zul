<?page title="OtilSoft Media Catalog" contentType="text/html;charset=UTF-8"?>
<zk>
<style>
    body {
        background: url('image/background.jpg');
        margin: auto;
        padding: 15px;
    }
</style>
<window id="mainWin" apply="org.zkoss.bind.BindComposer" viewModel="@id('mainVm') @init('hu.otilsoft.catalog.viewmodel.MainViewModel')" border="normal" width="100%">
    <menubar>
        <menu label="System">
            <menupopup>
                <menuitem id="config" label="Configuration..." onClick="@command('showSettings')"/>
                <menuitem id="export" label="Export..."/>
            </menupopup>
        </menu>
        <menu label="Data">
            <menupopup>
                <menuitem id="menuitem-storage-type" label="Storage type" image="image/storage_type.png" onClick="@global-command('showStorageType')" onMouseOver='statustext.value="Managing storage types"'/>
                <menuitem id="menuitem-storage" label="Storage" image="image/storage.png" onClick="@global-command('showStorage')" onMouseOver='statustext.value="Managing storages"'/>
                <menuitem id="menuitem-series" label="Series" image="image/series.png" onClick="@global-command('showSeries')" onMouseOver='statustext.value="Managing series"'/>
                <menuseparator/>
                <menuitem id="menuitem-movie" label="Movie" image="image/film.png" onClick="@global-command('listMovies')" onMouseOver='statustext.value="Managing movies"'/>
                <menuitem id="menuitem-game" label="Game" image="image/game.png" onClick="@global-command('listGames')" onMouseOver='statustext.value="Managing games"'/>
            </menupopup>
        </menu>
        <menu label="Search"/>
        <menu label="Random">
            <menupopup>
                <menuitem id="menuitem-random-least-seen-movie" label="Random least seen movie" onClick="@global-command('listMovies', action='randomLeastSeen')" onMouseOver='statustext.value="Finds a least seen movie randomly"'/>
                <menuseparator/>
                <menuitem id="menuitem-random-least-played-game" label="Random least played game" onClick="@global-command('listGames', action='randomLeastPlayed')" onMouseOver='statustext.value="Finds a least played game randomly"'/>
                <menuitem id="menuitem-random-played-game" label="Random played game" onClick="@global-command('listGames', action='randomPlayed')" onMouseOver='statustext.value="Finds an already played game randomly"'/>
            </menupopup>
        </menu>
        <menu label="Statistics">
            <menupopup>
                <menuitem id="menuitem-stat-counts" label="Number of assets" onClick="@global-command('statNumberOfAssets')" onMouseOver='statustext.value="Show the history graph of number of items"'/>
                <menuitem id="menuitem-stat-movie-history" label="Recently viewed movies" onClick="@global-command('statRecentlyViewedMovies')" onMouseOver='statustext.value="List of recently viewed movies"'/>
                <menuitem id="menuitem-stat-game-history" label="Last played games" onClick="@global-command('statLastPlayedGames')" onMouseOver='statustext.value="List of recently played games"'/>
            </menupopup>
        </menu>
    </menubar>
    <tabbox hflex="max">
        <tabs>
            <tab label="Data"/>
            <tab label="Másik"/>
        </tabs>
        <tabpanels>
            <tabpanel>
                <hbox>
                    <vbox>
                        <hbox width="100%">
                            <button image="image/storage_type_big.png" onClick="@global-command('showStorageType')"/>
                            <button image="image/storage_big.png" onClick="@global-command('showStorage')"/>
                            <button image="image/series_big.png" onClick="@global-command('showSeries')"/>
                        </hbox>
                        <hbox width="100%" pack="center">
                            <label value="Base"/>
                        </hbox>
                    </vbox>
                    <space bar="true" height="100%" spacing="5px"/>
                    <vbox>
                        <hbox width="100%">
                            <button image="image/film_big.png" onClick="@global-command('listMovies')"/>
                            <button image="image/game_big.png" onClick="@global-command('listGames')"/>
                        </hbox>
                        <hbox width="100%" pack="center">
                            <label value="Assets"/>
                        </hbox>
                    </vbox>
                </hbox>
            </tabpanel>
            <tabpanel>Cucc2</tabpanel>
        </tabpanels>
    </tabbox>
    <div visible="@load(mainVm.emptyVisible)">
        OtilSoft Media Catalog
    </div>
    <include id="content-storagetype" src="storagetype.zul" progressing="true" visible="@load(mainVm.storageTypeVisible)"/>
    <include id="content-storage" src="storage.zul" progressing="true" visible="@load(mainVm.storageVisible)"/>
    <include id="content-series" src="series.zul" progressing="true" visible="@load(mainVm.seriesVisible)"/>
    <include id="content-list-movie" src="movie-list.zul" progressing="true" visible="@load(mainVm.movieListVisible)"/>
    <include id="content-edit-movie" src="movie-edit.zul" progressing="true" visible="@load(mainVm.movieEditVisible)"/>
    <include id="content-list-game" src="game-list.zul" progressing="true" visible="@load(mainVm.gameListVisible)"/>
    <include id="content-edit-game" src="game-edit.zul" progressing="true" visible="@load(mainVm.gameEditVisible)"/>
    <include id="content-stat" src="stat.zul" progressing="true" visible="@load(mainVm.statVisible)"/>
    <include id="content-stat-recently-viewed" src="stat-recently-viewed.zul" progressing="true" visible="@load(mainVm.statRecentlyViewedVisible)"/>
    <toolbar>
        <label id="statustext" value="Idle"/>
    </toolbar>
</window>
<div style="height: 15px"/>
</zk>

<vbox viewModel="@id('vm') @init('hu.otilsoft.catalog.viewmodel.MovieViewModel')" width="100%">
    <div width="100%" height="100%">
        <grid model="@load(vm.movies)" visible="@load(not vm.editing)" mold="paging" pageSize="20" pagingPosition="bottom" width="100%" height="100%">
            <auxhead>
                <auxheader colspan="8">
                    <hbox width="100%" align="center" pack="start">
                        <image src="image/film_big.png"/>
                        <label value="List of existing movies" hflex="1"/>
                        <label value="Search" visible="@load(vm.searchVisible)"/>
                        <textbox hflex="min" visible="@load(vm.searchVisible)" onChanging="@command('search', event=event)" value="@bind(vm.searchText)"/>
                        <button label="New" image="image/add.png" onClick="@command('edit')">
                            <custom-attributes org.zkoss.zul.image.preload="true"/>
                        </button>
                        <button label="Refresh" image="image/refresh.png" onClick="@command('refresh')" visible='@load(vm.refreshVisible)'>
                            <custom-attributes org.zkoss.zul.image.preload="true"/>
                        </button>
                    </hbox>
                </auxheader>
            </auxhead>
            <columns>
                <column label="Name" sortAscending="@load(vm.ascComparator)" sortDescending="@load(vm.descComparator)"/>
                <column label="Original name" sort="auto(originalName)"/>
                <column label="Release" sort="auto(release)" hflex="min"/>
                <column label="Series" sort="auto(series.name)" hflex="min"/>
                <column label="Series number" sort="auto(seriesNum)" hflex="min"/>
                <column label="Viewed" sort="auto(counter)" hflex="min"/>
                <column label="Created" sort="auto(created)" hflex="min"/>
                <column label="Action" hflex="min"/>
            </columns>
            <template name="model">
                <row>
                    <label value="@load(each.name)" style="white-space:pre"/>
                    <label value="@load(each.originalName)" style="white-space:pre"/>
                    <label value="@load(each.release)"/>
                    <hbox>
                        <button label="@load(each.series.name)" onClick="@command('showSeriesItems', series=each.series)" visible="@load(each.belongToSeries)"/>
                    </hbox>
                    <label value="@load(each.seriesNum)"/>
                    <label value="@load(each.counter)" style="white-space:pre"/>
                    <label value="@load(each.created) @converter(vm.localDateTimeConverter)" style="white-space:pre"/>
                    <hbox>
                        <button label="Edit" image="image/edit.png" onClick="@command('edit', item=each)">
                            <custom-attributes org.zkoss.zul.image.preload="true"/>
                        </button>
                        <button label="Delete" image="image/delete.png" onClick="@command('delete', item=each)">
                            <custom-attributes org.zkoss.zul.image.preload="true"/>
                        </button>
                    </hbox>
                </row>
            </template>
        </grid>
        <grid visible="@load(vm.editing)" width="100%">
            <auxhead>
                <auxheader colspan="2">
                    <image src="image/edit_big.png"/>
                    Editing movie
                </auxheader>
            </auxhead>
            <columns>
                <column hflex="min"/>
                <column hflex="1"/>
            </columns>
            <rows>
                <row>
                    <label value="Name"/>
                    <textbox value="@bind(vm.editingMovie.name)" width="100%"/>
                </row>
                <row>
                    <label value="Original name"/>
                    <textbox value="@bind(vm.editingMovie.originalName)" width="100%"/>
                </row>
                <row>
                    <label value="Counter"/>
                    <spinner value="@bind(vm.editingMovie.counter)"/>
                </row>
                <row>
                    <label value="Rating"/>
                    <textbox value="@bind(vm.editingMovie.rating) @converter(vm.doubleConverter)"/>
                </row>
                <row>
                    <label value="Release"/>
                    <textbox value="@bind(vm.editingMovie.release)"/>
                </row>
                <row>
                    <label value="Link"/>
                    <hbox width="100%">
                        <textbox value="@bind(vm.editingMovie.link)" hflex="1"/>
                        <button label="Show" onClick="@command('openLink')"/>
                    </hbox>
                </row>
                <row>
                    <label value="Media"/>
                    <combobox model="@load(vm.media)" selectedItem="@bind(vm.editingMovie.media)">
                        <template name="model">
                            <comboitem label="${each.name}"/>
                        </template>
                    </combobox>
                </row>
                <row>
                    <label value="Media number"/>
                    <textbox value="@bind(vm.editingMovie.mediaNumber)" width="100%"/>
                </row>
                <row>
                    <label value="Storage"/>
                    <combobox model="@load(vm.storages)" selectedItem="@bind(vm.editingMovie.storage)">
                        <template name="model">
                            <comboitem label="${each.name} (${each.storageType.name})"/>
                        </template>
                    </combobox>
                </row>
                <row>
                    <label value="Series"/>
                    <combobox model="@load(vm.series)" selectedItem="@bind(vm.editingMovie.series)">
                        <template name="model">
                            <comboitem label="${each.name}"/>
                        </template>
                    </combobox>
                </row>
                <row>
                    <label value="Series number"/>
                    <spinner value="@bind(vm.editingMovie.seriesNum)"/>
                </row>
                <row>
                    <label value="Created"/>
                    <label value="@load(vm.editingMovie.created) @converter(vm.localDateTimeConverter)"/>
                </row>
                <row>
                    <label value="Updated"/>
                    <label value="@load(vm.editingMovie.updated) @converter(vm.localDateTimeConverter)"/>
                </row>
                <row>
                    <label value="Revision"/>
                    <label value="@load(vm.editingMovie.revision)"/>
                </row>
            </rows>
            <foot>
                <footer span="2" align="right">
                    <button label="Save" image="image/save.png" onClick="@command('save')">
                        <custom-attributes org.zkoss.zul.image.preload="true"/>
                    </button>
                    <button label="Delete" image="image/delete.png" onClick="@command('deleteEditing')">
                        <custom-attributes org.zkoss.zul.image.preload="true"/>
                    </button>
                    <button label="Cancel" image="image/cancel.png" onClick="@command('cancelEditing')">
                        <custom-attributes org.zkoss.zul.image.preload="true"/>
                    </button>
                </footer>
            </foot>
        </grid>
    </div>
</vbox>

<hbox viewModel="@id('vm') @init('hu.otilsoft.catalog.viewmodel.GameListViewModel')" width="100%">
    <grid model="@load(vm.games)" mold="paging" pageSize="20" pagingPosition="bottom" width="100%" height="100%">
        <auxhead>
            <auxheader colspan="6">
                <hbox width="100%" align="center" pack="start">
                    <image src="image/game_big.png"/>
                    <label value="List of recently played games" hflex="1"/>
                </hbox>
            </auxheader>
        </auxhead>
        <columns>
            <column label="Name"/>
            <column label="Release" hflex="min"/>
            <column label="Series" hflex="min"/>
            <column label="Series number" hflex="min"/>
            <column label="Played" hflex="min"/>
            <column label="Last played" hflex="min"/>
        </columns>
        <template name="model">
            <row>
                <label value="@load(each.name)" style="white-space:pre"/>
                <label value="@load(each.release)"/>
                <label value="@load(each.series.name)"/>
                <label value="@load(each.seriesNum)"/>
                <label value="@load(each.counter)" style="white-space:pre"/>
                <label value="@load(each.updated) @converter(vm.localDateTimeConverter)" style="white-space:pre"/>
            </row>
        </template>
    </grid>
</hbox>

<zk xmlns:w="http://www.zkoss.org/2005/zk/client">
<vbox viewModel="@id('vm') @init('hu.otilsoft.catalog.viewmodel.StatViewModel')" width="100%">
<div id="chart" width="100%" height="100%"/>
</vbox>
<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<script type="text/javascript">
  google.charts.load("current", {packages:["corechart"]});
  // google.charts.setOnLoadCallback(drawChart);

  function sleep(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }

  async function drawChart(tableData) {
    var data = google.visualization.arrayToDataTable(tableData);

    var options = {
      title: 'My Daily Work Activities',
      is3D: false,
      height: 600,
      legend: {
        position: 'top'
      }
    };

    id = zk.Widget.$("$chart").uuid
    console.log("ITT0:" + document.getElementById(id).clientWidth);

    while (document.getElementById(id).clientWidth == 0) {
        await sleep(20);
    }

    var chart = new google.visualization.LineChart(zk.Widget.$("$chart").$n());
    chart.draw(data, options);
  }
</script>
</zk>

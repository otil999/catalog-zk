<window id="w" use="hu.otilsoft.catalog.MyComposer" apply="hu.otilsoft.catalog.MyComposer" border="normal">
	<tabbox>
		<tabs>
			<tab label="default"/>
		</tabs>
		<tabpanels>
			<tabpanel>
		    	<button id="ok" label="Ok" forward="w.onOk()"/>
		    	<button id="cancel" label="Cancel" forward="w.onCancel()"/>
	    	</tabpanel>
		</tabpanels>
	</tabbox>
	<window id="w2" title="Test echoEvent" use="hu.otilsoft.catalog.MyComposer" border="normal">
	    <button label="echo" forward="w.onLongRun()"/>
	    <label id="status">NOOP</label>    
	</window>	
</window>
